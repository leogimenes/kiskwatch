{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kiskwatch",
  "version": "0.1.0",
  "identifier": "io.github.leogimenes.kiskwatch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "panel",
        "title": "Kiskwatch",
        "url": "index.html",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480
      },
      {
        "label": "overlay",
        "title": "Kiskwatch overlay",
        "url": "overlay.html",
        "width": 340,
        "height": 260,
        "x": 40,
        "y": 120,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false
      },
      {
        "label": "pets",
        "title": "Kiskwatch pets",
        "url": "pets.html",
        "width": 320,
        "height": 420,
        "x": 40,
        "y": 400,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
